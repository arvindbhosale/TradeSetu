{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradeSetu",
  "version": "0.6.0",
  "identifier": "in.tradesetu.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "appimage", "deb"],
    "category": "Finance",
    "shortDescription": "Trading desk for NSE and BSE",
    "longDescription": "TradeSetu: strategy backtests, paper trading and live orders on Zerodha Kite for NSE and BSE.",
    "copyright": "MIT licensed",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../dist/desk-backend/": "backend/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
