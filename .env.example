# TradeSetu configuration template.
#
# Copy to .env and fill in:   cp .env.example .env
# .env is git-ignored. Never commit it, paste it in an issue, or share a screenshot of it.
# On Dokploy, paste these lines under the service's Environment tab instead.

# --- Hosted mode (VPS / Docker / Dokploy) ---------------------------------------

# The domain the desk is served on, without https:// (the same one you add in Dokploy).
DESK_DOMAIN=desk.example.com

# Sign-in for the panel. Use a long, unique password: this panel can place orders.
DESK_ADMIN_USER=admin
# Letters, digits, - and _ only: "$" and "#" are rewritten by env files, and quotes become part of it.
# At least 10 characters; longer is better.
DESK_ADMIN_PASSWORD=
# Or, instead of the password, its hash from `python -m desk.auth` (leave the password empty).
# DESK_ADMIN_PASSWORD_HASH=

# If the desk is reached through more than one address, the one passkeys are made for.
# DESK_PUBLIC_URL=https://desk.example.com

# Set to 1 for one deploy to switch two-factor sign-in off (lost phone), then remove it.
# DESK_2FA_RESET=

# --- Zerodha Kite Connect (needed for live orders and Kite market data) ----------

# Create an app at https://developers.kite.trade
# Redirect URL in the app: https://<DESK_DOMAIN>/kite/callback
# SEBI rules: register your server's static IP in the Kite Connect app, or orders are refused.
KITE_API_KEY=
KITE_API_SECRET=

# --- Optional -------------------------------------------------------------------

# Where settings, paper trades, algos and logs are stored (default ~/.tradingagents/desk).
# TRADESETU_HOME=

# LLM provider keys for the AI "Analyze" tab and the agents CLI. In the desk you can
# also paste them under Settings instead. Only the one you use is needed.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# Optional data sources (also settable under Settings).
# FRED_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# Alerts to Telegram (bot token and chat ID are set in the desk under Settings → Alerts).

# Update checks are off unless you point them at a release feed.
# TRADESETU_RELEASES_URL=https://api.github.com/repos/<owner>/TradeSetu/releases/latest
